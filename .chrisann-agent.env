# Chrisann's Hermes Agent — Environment Configuration
# DO NOT COMMIT THIS FILE. It is listed in .gitignore.
# This file wires Chrisann's agent instance to her dedicated LiteLLM proxy.

# =============================================================================
# LLM PROVIDER — Chrisann's LiteLLM Proxy (OpenAI-compatible)
# =============================================================================
# The framework's OpenRouter provider is reused here because LiteLLM exposes
# an identical OpenAI-compatible API. The base_url is overridden in
# cli-config-chrisann.yaml to point to Chrisann's proxy instead of openrouter.ai.
#
# Set this to Chrisann's LiteLLM master key (found in .chrisann.env in the litellm dir):
OPENROUTER_API_KEY=sk-Test5606!

# =============================================================================
# VOICE / STT — Route through Chrisann's LiteLLM proxy
# =============================================================================
# LiteLLM exposes /v1/audio/speech (TTS) and /v1/audio/transcriptions (Whisper).
# Set the STT base URL so Hermes sends audio requests to Chrisann's proxy as well.
STT_OPENAI_BASE_URL=http://litellm-chrisann:4000/v1
VOICE_TOOLS_OPENAI_KEY=sk-Test5606!

# =============================================================================
# DEBUG (set to true only during troubleshooting)
# =============================================================================
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
GATEWAY_ALLOW_ALL_USERS=true
