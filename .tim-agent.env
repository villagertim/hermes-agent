# Tim's Hermes Agent — Environment Configuration
# DO NOT COMMIT THIS FILE. It is listed in .gitignore.
# This file wires Tim's agent instance to his dedicated LiteLLM proxy.

# =============================================================================
# LLM PROVIDER — Tim's LiteLLM Proxy (OpenAI-compatible)
# =============================================================================
# The framework's OpenRouter provider is reused here because LiteLLM exposes
# an identical OpenAI-compatible API. The base_url is overridden in
# cli-config-tim.yaml to point to Tim's proxy instead of openrouter.ai.
#
# Set this to Tim's LiteLLM master key (found in .tim.env in the litellm dir):
OPENROUTER_API_KEY=sk-Test2486!

# =============================================================================
# VOICE / STT — Route through Tim's LiteLLM proxy
# =============================================================================
# LiteLLM exposes /v1/audio/speech (TTS) and /v1/audio/transcriptions (Whisper).
# Set the STT base URL so Hermes sends audio requests to Tim's proxy as well.
STT_OPENAI_BASE_URL=http://litellm-tim:4000/v1
VOICE_TOOLS_OPENAI_KEY=sk-Test2486!

# =============================================================================
# DEBUG (set to true only during troubleshooting)
# =============================================================================
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
GATEWAY_ALLOW_ALL_USERS=true
